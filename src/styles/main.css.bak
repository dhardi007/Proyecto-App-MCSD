@import "tailwindcss";
@import "tailwind-animations";

/* Google Fonts */
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;900&family=Outfit:wght@400;600;800&display=swap");

/* Variables CSS personalizadas */
:root {
  --color-bg-primary: #f0fdfc;
  --color-bg-secondary: #b8f0ed;
  --color-text-primary: #134e4a;
  --color-text-secondary: #0f766e;
}

/* Estilos base */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  font-size: 112.5%; /* 18px base */
  scroll-behavior: smooth;
}

body {
  font-family: "Inter", system-ui, sans-serif;
  background: linear-gradient(135deg, #f0fdfc 0%, #ccfbf6 100%);
  color: var(--color-text-primary);
  overflow-x: hidden;
  line-height: 1.7;
}

/* Headings */
h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: "Outfit", system-ui, sans-serif;
  font-weight: 700;
}

h1 {
  font-size: 2.8rem;
  margin-bottom: 1rem;
}

h2 {
  font-size: 2.4rem;
  margin-bottom: 0.875rem;
}

h3 {
  font-size: 2rem;
  margin-bottom: 0.75rem;
}

h4 {
  font-size: 1.75rem;
  margin-bottom: 0.625rem;
}

p {
  margin-bottom: 1rem;
}

/* Navigation links */
nav a {
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  transition: all 0.2s ease;
}

nav a:hover {
  background-color: rgba(255, 255, 255, 0.15);
}

/* Glassmorphism utility */
.glass {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

/* Gradient text */
.gradient-text {
  background: linear-gradient(135deg, #14b8a6 0%, #0ea5e9 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: #f0fdfc;
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, #14b8a6 0%, #0ea5e9 100%);
  border-radius: 5px;
}

::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(180deg, #0d9488 0%, #0284c7 100%);
}

/* Animación de entrada para splash */
@keyframes fadeOut {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
    visibility: hidden;
  }
}

.splash-exit {
  animation: fadeOut 0.5s ease-out forwards;
}
